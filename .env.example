# Copy to .env (server, chmod 600) or .env.local (PC, dev key). Never commit real values.
# primary; www.stoprop.tech and stoprop.srv2159153.hstgr.cloud also routed
DOMAIN=stoprop.tech
# Hostinger AI Router, OpenAI-compatible
ROUTER_BASE_URL=https://router.hostinger.com/v1
# sk-hstgr-...  server .env: stoprop-prod key; PC .env.local: stoprop-dev key
ROUTER_API_KEY=
# default until the bake-off decides
MODEL_TAGGER=gemini-3.5-flash-lite-eu   # bake-off 2026-11-14: same F1 as Haiku at ~1/3 of the credits
MODEL_SUMMARY=claude-haiku-4.5-eu
# swarm deep mode only
MODEL_EMBED=text-embedding-3-small-eu
BAKEOFF_MODELS=claude-haiku-4.5-eu,gemini-3.5-flash-lite-eu,gpt-5.4-mini,mistral-small-4-eu
# Prefer -eu variants; never reasoning models in the tagger; claude-fable-5.2 / claude-opus-5.5
# only for rare offline adjudication.
DAILY_TOKEN_CAP=2000000
PUBLIC_BASE_URL=https://stoprop.tech
# optional, Google Fact Check Tools (AIza...)
FACTCHECK_API_KEY=
# none | oxylabs | exa
SEARCH_PROVIDER=none
SEARCH_API_KEY=

# Copy to .env (server, chmod 600) or .env.local (PC, dev key). Never commit real values.
# primary; www.stoprop.tech and stoprop.srv2159153.hstgr.cloud also routed
DOMAIN=stoprop.tech
# Hostinger AI Router, OpenAI-compatible
ROUTER_BASE_URL=https://router.hostinger.com/v1
# sk-hstgr-...  use a separate key for prod (with a daily limit) and for dev/eval
ROUTER_API_KEY=
# default until the bake-off decides
MODEL_TAGGER=claude-haiku-4.5-eu
MODEL_SUMMARY=claude-haiku-4.5-eu
BAKEOFF_MODELS=claude-haiku-4.5-eu,gemini-3.5-flash-lite-eu,gpt-5.4-mini,mistral-small-4-eu
# Rules: prefer -eu variants; never use reasoning models (gpt-5*, *-reasoning) in the tagger;
# expensive models (claude-fable-5.2, claude-opus-5.5) only for rare offline adjudication.
DAILY_TOKEN_CAP=2000000
PUBLIC_BASE_URL=https://stoprop.tech
# comma separated, for CORS, e.g. chrome-extension://abcdefghijklmnop
EXTENSION_ORIGINS=
# optional, Google Fact Check Tools
FACTCHECK_API_KEY=
# none | oxylabs | exa  (for syndication receipts)
SEARCH_PROVIDER=none
SEARCH_API_KEY=

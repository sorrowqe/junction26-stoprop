# Copy to .env (server, chmod 600) or .env.local (PC, dev key). Never commit real values.
# primary; www.stoprop.tech and stoprop.srv2159153.hstgr.cloud also routed
DOMAIN=stoprop.tech
# Hostinger AI Router, OpenAI-compatible
ROUTER_BASE_URL=https://router.hostinger.com/v1
# sk-hstgr-...  server .env: stoprop-prod key; PC .env.local: stoprop-dev key
ROUTER_API_KEY=
# default until the bake-off decides
MODEL_TAGGER=gemini-3.5-flash-lite-eu   # bake-off 2026-11-14: same F1 as Haiku at ~1/3 of the credits
MODEL_SUMMARY=gemini-3.5-flash-lite-eu   # trace: one small call to pick search sentences
# swarm deep mode only
MODEL_EMBED=text-embedding-3-small-eu
BAKEOFF_MODELS=claude-haiku-4.5-eu,gemini-3.5-flash-lite-eu,gpt-5.4-mini,mistral-small-4-eu
# Prefer -eu variants; never reasoning models in the tagger; claude-fable-5.2 / claude-opus-5.5
# only for rare offline adjudication.
DAILY_TOKEN_CAP=2000000
PUBLIC_BASE_URL=https://stoprop.tech
# optional, Google Fact Check Tools (AIza...)
FACTCHECK_API_KEY=
GOOGLE_API_KEY=                          # optional, YouTube Data API v3 (swarm mode: collect comments from a video link)
# Search & anti-bot scraping:
# - BRAVE_API_KEY: Brave Search API key (X-Subscription-Token) -> fast primary search for Verify, Trace, and Source copies
# - SEARCH_API_KEY (or OXYLABS_API_KEY): Oxylabs AI Studio key (x-api-key) -> anti-bot JS web scraper fallback + search fallback
# - SEARCH_PROVIDER: auto | brave | oxylabs | none  (set to auto, brave, or oxylabs in .env)
SEARCH_PROVIDER=auto
BRAVE_API_KEY=
SEARCH_API_KEY=
OXYLABS_API_KEY=
OXYLABS_DAILY_CAP=150                    # max Oxylabs AI Studio calls per UTC day (protects your 1000 credits)
RATE_LIMIT_MULTIPLIER=1                  # optional: set to 3 on shared venue Wi-Fi so NAT users don't 429 each other
